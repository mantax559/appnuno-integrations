ARG PHP_VERSION=8.3

FROM wordpress:cli-php${PHP_VERSION}

USER root

RUN if php -r 'exit(PHP_VERSION_ID < 70000 ? 0 : 1);'; then docker-php-ext-install mysql; fi

COPY docker/cacert.pem /etc/ssl/certs/ca-certificates.crt
RUN printf 'openssl.cafile=/etc/ssl/certs/ca-certificates.crt\ncurl.cainfo=/etc/ssl/certs/ca-certificates.crt\n' > /usr/local/etc/php/conf.d/cafile.ini
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
