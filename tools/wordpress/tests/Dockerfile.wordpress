ARG WORDPRESS_VERSION=7.1.4
ARG PHP_VERSION=8.3

FROM wordpress:php${PHP_VERSION}-apache

ARG WORDPRESS_VERSION

RUN set -eu; \
    curl -fsSL "https://wordpress.org/wordpress-${WORDPRESS_VERSION}.tar.gz" -o /tmp/wordpress.tar.gz; \
    rm -rf /usr/src/wordpress; \
    mkdir -p /usr/src/wordpress; \
    tar -xzf /tmp/wordpress.tar.gz --strip-components=1 -C /usr/src/wordpress; \
    rm /tmp/wordpress.tar.gz
